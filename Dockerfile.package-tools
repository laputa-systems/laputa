# check=skip=InvalidDefaultArgInFrom
# The offline package-tools image: the host-tools base plus the prebuilt LLVM
# seed. seed/images.xsh builds it with `--network none` and tags it with a
# content key; the profile builds use `--platform linux/arm64`.
#
# The image bakes no XSH, PM, or recipes. Containers mount the seed XSH at
# /bin/{xsh,xshi,xsht} with its core applets at /usr/lib/xsh/core, and the
# checkout read-only at /src/laputa, so neither an XSH nor a PM change
# rebuilds this image.
#
# Inputs:
#   HOST_TOOLS_IMAGE   the loaded laputa-host-tools tag
#   context `seed`     .out/seed/<arch>, the local XSH seed
#   context `sources`  a staged source cache holding sha256/<llvm archive digest>
#   main context       the checkout (PM, the llvm-toolchain recipe, the helper)
ARG HOST_TOOLS_IMAGE

# The helper uses the typed recipe boundary to materialize the prebuilt
# target LLVM seed before any PM BuildPlan runs. The seed XSH and the checkout
# are bind mounts, so neither lands in a layer.
FROM ${HOST_TOOLS_IMAGE} AS llvm-seed
ARG XSH_PM_TARGET_ARCH
ENV PATH=/opt/xsh-seed:/bin:/usr/bin
ENV XSH_PM_TARGET_ARCH=${XSH_PM_TARGET_ARCH}
ENV XSH_MODULE_PATH=/src/laputa
RUN --mount=type=bind,from=seed,target=/opt/xsh-seed \
    --mount=type=bind,from=sources,target=/sources \
    --mount=type=bind,target=/src/laputa \
    ["/opt/xsh-seed/xsh", "/src/laputa/bootstrap-llvm-seed.xsh", "--", "/src/laputa", "/sources", "/seed-root"]

FROM ${HOST_TOOLS_IMAGE} AS package-tools
ARG XSH_PM_TARGET_ARCH
COPY --from=llvm-seed /seed-root/ /

# Keep the runtime mounts explicit and stable. `/src/laputa` is the
# authoritative checked-out monorepo (PM, recipes, profiles, system modules);
# system/docker.xsh mounts it read-only for each structured PM command.
RUN mkdir -p /src/laputa /artifacts /output /usr/lib/xsh/core && \
    test -x /usr/bin/cc && (test -x /sbin/mkfs.ext4 || test -x /usr/sbin/mkfs.ext4)
WORKDIR /src/laputa
# Core applets precede /usr/bin as their /usr/bin symlinks did in installed
# roots; Alpine's /bin tools keep precedence.
ENV PATH=/bin:/usr/lib/xsh/core:/usr/bin
ENV XSH_MODULE_PATH=/src/laputa
ENV XSH_PM_TARGET_ARCH=${XSH_PM_TARGET_ARCH}
ENV XSH_PM_BOOTSTRAP_LLVM_ROOT=/usr/lib/llvm23
