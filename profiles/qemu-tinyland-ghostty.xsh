##! Opt-in Laputa kiosk profile: unprivileged tinyland through seatd-mediated devices, Ghostty on virgl.
use system.types

## The direct package intent for a tinyland and Ghostty system without dwl, wlroots,
## libinput, or LLVM in the runtime closure. Ghostty renders offscreen through
## Mesa's virgl driver and presents over wl_shm; dependencies are resolved by PM.
export let profile: types.SystemProfile = types.SystemProfile(
  name: "qemu-tinyland-ghostty",
  package_roots: [
    "baselayout",
    "ca-certificates",
    "xsh",
    "laputa-pm",
    "xinit",
    "mdevd-rs",
    "seatd-rs",
    "doas-rs",
    "tinyland",
    "ghostty-custom",
  ],
  kernel_package: "linux",
  kernel_path: p"boot/vmlinuz",
  qemu_smp: 2,
  qemu_memory: "1536M",
  qemu_width: 1280,
  qemu_height: 800,
  forbidden_packages: [
    "llvm-toolchain",
    "pkgconf",
    "cmake",
    "muon",
    "samurai",
    "seatd",
    "mdevd",
    "m4",
    "flex",
    "bison",
    "wayland-dev",
    "wayland-protocols",
    "pixman-dev",
    "dbus",
    "systemd",
    "xwayland",
    "gtk",
    "pango",
    "pipewire",
    "pulseaudio",
    "python",
    "dwl-minimal",
    "wlroots0.20",
    "libinput",
    "wayland-libs-server",
  ],
  forbidden_sonames: ["libLLVM", "libclang", "libpython", "libgtk", "libpango", "libpipewire", "libpulse", "libwlroots", "libinput"],
  proof: {
    cmdline_flag: "LAPUTA_QEMU_TINYLAND_GHOSTTY_PROOF",
    ready_marker: "LAPUTA_TINYLAND_GHOSTTY_PROOF_READY",
    success_marker: "LAPUTA_TINYLAND_GHOSTTY_PROOF_OK",
    failure_marker: "LAPUTA_TINYLAND_GHOSTTY_PROOF_FAILED",
    input_mode: types.ProofModifiers,
  },
  qemu_gpu: types.Virgl,
  development: true,
)
