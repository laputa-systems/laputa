##! Experimental Laputa kiosk profile: unprivileged tinyland through seatd-mediated devices and Play
##! on Mesa's Venus Vulkan driver over QEMU virtio-gpu.
use system.types

## The direct package intent for a tinyland and Play system whose guest Mesa is only the Venus `virtio`
## Vulkan driver: no Ghostty, no virgl or softpipe, no lavapipe and no LLVM. The host GPU executes
## Play's Vulkan work through virglrenderer; a 2D virtio-gpu scanout stays first so the host can
## screenshot the compositor. The canonical qemu-tinyland-ghostty profile is the control.
export let profile: types.SystemProfile = types.SystemProfile(
  name: "qemu-tinyland-venus",
  package_roots: [
    "baselayout",
    "ca-certificates",
    "xsh",
    "laputa-pm",
    "xinit",
    "mdevd-rs",
    "seatd-rs",
    "doas-rs",
    "tinyland",
    "mesa-venus",
    "play",
    "font-ttf-noto-sans-devanagari",
    "font-ttc-noto-sans-cjk",
    "font-ttf-noto-color-emoji",
  ],
  kernel_package: "linux",
  kernel_path: p"boot/vmlinuz",
  qemu_smp: 2,
  qemu_memory: "1536M",
  qemu_width: 1280,
  qemu_height: 800,
  forbidden_packages: [
    "mesa",
    "ghostty-custom",
    "llvm-toolchain",
    "llvm-static",
    "pkgconf",
    "cmake",
    "gluon",
    "seatd",
    "mdevd",
    "m4",
    "flex",
    "bison",
    "wayland-dev",
    "wayland-protocols",
    "pixman-dev",
    "dbus",
    "systemd",
    "xwayland",
    "gtk",
    "pango",
    "pipewire",
    "pulseaudio",
    "python",
    "dwl-minimal",
    "wlroots0.20",
    "libinput",
    "wayland-libs-server",
    "fontconfig",
    "expat",
  ],
  forbidden_sonames: ["libLLVM", "libclang", "libpython", "libgtk", "libpango", "libpipewire", "libpulse", "libwlroots", "libinput", "libgallium", "libvulkan_lvp", "libEGL", "libGLESv2", "libgbm"],
  proof: {
    cmdline_flag: "LAPUTA_QEMU_TINYLAND_VENUS_PROOF",
    ready_marker: "LAPUTA_TINYLAND_VENUS_PROOF_READY",
    success_marker: "LAPUTA_TINYLAND_VENUS_PROOF_OK",
    failure_marker: "LAPUTA_TINYLAND_VENUS_PROOF_FAILED",
    input_mode: .ProofModifiers,
  },
  qemu_gpu: .Venus(256),
  development: true,
)
