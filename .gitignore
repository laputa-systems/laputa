# Derived state and fetched inputs.
.out/
.cache/
target/

# Mirror build outputs.
mirror/target/
mirror/node_modules/
mirror/static/js/*.js
*.deb

# PM build leftovers written beside recipes.
packages/run-package-build.trace
packages/*/run-package-build.xsh

# Local secrets; nothing in the tree reads them.
.env

# Operator-provisioned trust-update signing key. Never commit: production
# trust depends on this key staying outside the repository. Builds fail
# closed without it; see docs/CERTIFICATE-TRUST.md (key ceremony).
packages/ca-certificates/files/trust-update-key
# The private signing half must live offline, never in the tree.
# Ignored anywhere as a safety net against accidental commit.
trust-signing.key

# cf cli
.cloudflare/

__pycache__/
