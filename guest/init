#!/bin/sh
mount -o remount,rw /
mkdir -p /dev/pts /dev/shm /tmp
mount -t devpts none /dev/pts
export PATH=/usr/local/bin:/usr/bin:/bin:/sbin
echo "MDEVD_QEMU_BOOT" > /dev/console

fail() {
  echo "MDEVD_QEMU_FAIL $1" > /dev/console
  sleep 2
  poweroff -f
  sleep 30
  exit 1
}

check_node() {
  dir=$1
  expected=$(cat /sys/block/vda/dev) || return 1
  exp_maj=${expected%%:*}
  exp_min=${expected##*:}
  test -b "$dir/vda" || return 1
  # shellcheck disable=SC2046
  set -- $(ls -l "$dir/vda")
  got_maj=$(printf '%s' "$5" | tr -d ',')
  got_min=$6
  test "$got_maj" = "$exp_maj" || return 1
  test "$got_min" = "$exp_min" || return 1
  test "$(stat -c '%a' "$dir/vda")" = 660 || return 1
  return 0
}

check_output() {
  out=$1
  test -s "$out" || return 1
  tr '\0' '\n' < "$out" | grep -q 'ACTION=add' || return 1
  tr '\0' '\n' < "$out" | grep -q 'DEVNAME=vda' || return 1
  tr '\0' '\n' < "$out" | grep -q 'MAJOR=' || return 1
  tr '\0' '\n' < "$out" | grep -q 'MINOR=' || return 1
  return 0
}

run_case() {
  tag=$1
  daemon=$2
  coldplug=$3
  ldpath=$4
  devdir=/tmp/qdev-$tag
  rm -rf "$devdir"
  mkdir -p "$devdir"
  cat > /tmp/mdev.conf <<'EOF'
vda root:root 660
.* root:root 600
EOF
  rm -f /tmp/ready.log /tmp/output.bin
  exec 3> /tmp/ready.log
  exec 4> /tmp/output.bin
  if [ -n "$ldpath" ]; then
    LD_LIBRARY_PATH=$ldpath "$daemon" -f /tmp/mdev.conf -d "$devdir" -s /sys -O 4 -D 3 -o 4 &
  else
    "$daemon" -f /tmp/mdev.conf -d "$devdir" -s /sys -O 4 -D 3 -o 4 &
  fi
  pid=$!
  exec 3>&-
  exec 4>&-
  ready=0
  i=0
  while [ $i -lt 50 ]; do
    if test -s /tmp/ready.log; then ready=1; break; fi
    if ! kill -0 $pid 2>/dev/null; then fail "$tag daemon exited before readiness"; fi
    sleep 0.1
    i=$((i + 1))
  done
  test $ready = 1 || fail "$tag no readiness"
  test -b /sys/block/vda 2>/dev/null || test -e /sys/block/vda/uevent || fail "$tag no vda sysfs"
  echo add > /sys/block/vda/uevent || fail "$tag trigger failed"
  sleep 1
  check_node "$devdir" || fail "$tag node check failed"
  check_output /tmp/output.bin || fail "$tag output check failed"
  cp /tmp/output.bin "/tmp/output-$tag.bin"
  if [ -n "$ldpath" ]; then
    LD_LIBRARY_PATH=$ldpath timeout 30 "$coldplug" -s /sys -O 4 || fail "$tag coldplug failed"
  else
    timeout 30 "$coldplug" -s /sys -O 4 || fail "$tag coldplug failed"
  fi
  kill -TERM $pid || fail "$tag term failed"
  i=0
  while kill -0 $pid 2>/dev/null; do
    sleep 0.1
    i=$((i + 1))
    test $i -lt 50 || fail "$tag daemon ignored TERM"
  done
  wait $pid
  test $? = 0 || fail "$tag daemon exit nonzero"
  echo "MDEVD_QEMU_${tag}_OK" > /dev/console
}

run_case RUST /usr/local/bin/mdevd /usr/local/bin/mdevd-coldplug ""
run_case C /usr/local/bin/mdevd-c /usr/local/bin/mdevd-coldplug-c /usr/local/lib/mdevd
echo "MDEVD_QEMU_OK" > /dev/console
sleep 1
poweroff -f
sleep 30
