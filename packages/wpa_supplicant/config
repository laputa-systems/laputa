# Minimal wpa_supplicant config for WPA2-PSK with internal crypto (no openssl).
# No IPv6, no D-Bus, no EAP, no WPS, no P2P, no AP mode.
# The nl80211 driver links libnl3 (libnl-3 and libnl-genl-3).
#
# This file is the build's source of truth: the recipe's object list and
# defines are what upstream's wpa_supplicant/Makefile derives from it. Keep
# them in step when it changes.

CONFIG_TLS=internal
CONFIG_CRYPTO=internal
CONFIG_INTERNAL_LIBTOMMATH=y

CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

CONFIG_CTRL_IFACE=y
CONFIG_WPA_CLI_EDIT=y
CONFIG_BACKEND=file

CONFIG_GETRANDOM=y
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON
CONFIG_BGSCAN_SIMPLE=y

# Disable everything not strictly needed for WPA2-Personal.
# No CONFIG_SAE or CONFIG_ECC: SAE (WPA3-Personal) needs crypto_ec_*, which
# only the OpenSSL and wolfSSL crypto backends implement.
# No CONFIG_DRIVER_WEXT, CONFIG_DRIVER_WIRED.
# No CONFIG_IEEE8021X_EAPOL, CONFIG_EAP_*, CONFIG_PKCS12.
# No CONFIG_WPS, CONFIG_AP, CONFIG_P2P, CONFIG_MESH, CONFIG_TDLS.
# No CONFIG_IEEE80211R, CONFIG_FILS, CONFIG_OWE, CONFIG_DPP.
# No CONFIG_IPV6, CONFIG_CTRL_IFACE_DBUS.
# No CONFIG_READLINE (use CONFIG_WPA_CLI_EDIT).
# No CONFIG_PCSC, CONFIG_SMARTCARD.
# No CONFIG_FIPS, CONFIG_PRIVSEP.
# No CONFIG_ACS, CONFIG_HS20, CONFIG_INTERWORKING.
# No CONFIG_WIFI_DISPLAY, CONFIG_IBSS_RSN.
# No CONFIG_HT_OVERRIDES, CONFIG_VHT_OVERRIDES, CONFIG_HE_OVERRIDES.
