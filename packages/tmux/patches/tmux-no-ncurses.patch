+static const char *
+tparm_skip_to_eb(const char *s)
+{
+	/* Skip forward to matching %e or %; at depth 0. Returns ptr to the %. */
+	int	depth = 0;
+
+	while (*s != '\0') {
+		if (*s != '%') {
+			s++;
+			continue;
+		}
+		switch (*(s + 1)) {
+		case '?':
+			depth++;
+			s += 2;
+			break;
+		case 'e':
+			if (depth == 0)
+				return s;
+			s += 2;
+			break;
+		case ';':
+			if (depth == 0)
+				return s;
+			depth--;
+			s += 2;
+			break;
+		case '{':
+			s += 2;
+			while (*s != '\0' && *s != '}')
+				s++;
+			if (*s != '\0')
+				s++;
+			break;
+		case '\'':
+			s += 2;
+			if (*s != '\0')
+				s++;
+			if (*s == '\'')
+				s++;
+			break;
+		default:
+			s += 2;
+			break;
+		}
+	}
+	return s;
+}
