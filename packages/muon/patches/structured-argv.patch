 void
+argv_hex(struct workspace *wk, struct tstr *sb, const char *str)
+{
+	static const char hex[] = "0123456789abcdef";
+	for (const unsigned char *s = (const unsigned char *)str; *s; ++s) {
+		tstr_push(wk, sb, hex[*s >> 4]);
+		tstr_push(wk, sb, hex[*s & 15]);
+	}
+}
+
+obj
+join_args_argv(struct workspace *wk, obj arr)
+{
+	TSTR(res);
+	obj val;
+	obj_array_for_(wk, arr, val, iter) {
+		if (iter.i) tstr_push(wk, &res, ' ');
+		tstr_push(wk, &res, 'x');
+		argv_hex(wk, &res, get_cstr(wk, val));
+	}
+	return tstr_into_str(wk, &res);
+}
+
+obj
+join_template_argv(struct workspace *wk, obj arr, obj rule_args, obj encoded_rule_args)
+{
+	TSTR(res);
+	obj val;
+	obj_array_for_(wk, arr, val, iter) {
+		const char *s = get_cstr(wk, val);
+		if (iter.i) tstr_push(wk, &res, ' ');
+		if (rule_args && val == rule_args && encoded_rule_args) {
+			tstr_pushs(wk, &res, get_cstr(wk, encoded_rule_args));
+		} else if (!strcmp(s, "$ARGS")) tstr_pushs(wk, &res, "$ARGV_ARGS");
+		else if (!strcmp(s, "$LINK_ARGS")) tstr_pushs(wk, &res, "$ARGV_LINK_ARGS");
+		else if (!strcmp(s, "$LINK_EARLY_ARGS")) tstr_pushs(wk, &res, "$ARGV_LINK_EARLY_ARGS");
+		else if (!strcmp(s, "$in")) tstr_pushs(wk, &res, "$in_argv");
+		else if (!strcmp(s, "$out")) tstr_pushs(wk, &res, "$out_argv");
+		else if (!strcmp(s, "${out}.d")) tstr_pushs(wk, &res, "x${out_hex}2e64");
+		else { tstr_push(wk, &res, 'x'); argv_hex(wk, &res, s); }
+	}
+	return tstr_into_str(wk, &res);
+}
