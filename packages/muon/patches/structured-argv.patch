+static int
+samu_hexval(char c)
+{
+	if (c >= '0' && c <= '9') return c - '0';
+	if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+	return -1;
+}
+
+static bool
+samu_run_argv(struct samu_ctx *ctx, struct run_cmd_ctx *run, struct samu_string *encoded)
+{
+	if (!encoded) { samu_warn("edge lacks structured argv"); return false; }
+	char *data = malloc(encoded->n + 1);
+	char **argv = calloc(encoded->n + 2, sizeof(*argv));
+	if (!data || !argv) samu_fatal("out of memory");
+	const char *p = encoded->s;
+	char *out = data;
+	size_t argc = 0;
+	while (*p) {
+		while (*p == ' ') ++p;
+		if (!*p) break;
+		if (*p++ != 'x') goto invalid;
+		argv[argc++] = out;
+		while (*p && *p != ' ') {
+			int hi = samu_hexval(*p++);
+			if (hi < 0 || !*p) goto invalid;
+			int lo = samu_hexval(*p++);
+			if (lo < 0 || !(hi | lo)) goto invalid;
+			*out++ = (char)((hi << 4) | lo);
+		}
+		*out++ = 0;
+	}
+	if (!argc || !argv[0][0]) goto invalid;
+	bool started = run_cmd_argv(ctx->wk, run, argv, 0, 0);
+	free(argv); free(data);
+	return started;
+invalid:
+	samu_warn("invalid structured argv");
+	free(argv); free(data);
+	return false;
+}
