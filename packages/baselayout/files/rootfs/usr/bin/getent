#!/bin/xsh
pure entry_matches(database: Str, line: Str, key: Str) -> Bool {
  return true when key == ""

  let fields = line.split(":")

  return true when (fields.get(0) ?? "") == key

  return true when database == "passwd" and (fields.get(2) ?? "") == key

  return true when database == "group" and (fields.get(2) ?? "") == key

  false
}

proc main(database = "", key = "") [fs, error] {
  if database == "" {
    exit 2
  }

  var path_value: Path = /etc/passwd

  if database == "passwd" {
    path_value = /etc/passwd
  } else if database == "group" {
    path_value = /etc/group
  } else {
    exit 2
  }

  var found = false

  for raw in path_value.read_lines()? {
    let line = raw.trim()
    continue when line == "" or line.starts_with("#")

    if entry_matches(database, line, key) {
      print ${line}
      found = true
    }
  }

  if ! found {
    exit 2
  }
}
