#!/bin/sh
here=$(cd "$(dirname "$0")/.." && pwd)
link=shared
system=
libs=
out=
platform=$(uname -s)

link_symbol() {
  case "$platform" in
    Darwin) printf '%s' "-Wl,-alias,_main,_$1" ;;
    *) printf '%s' "-Wl,--defsym,$1=0" ;;
  esac
}

for arg in "$@"; do
  case $arg in
    --version) out="$out 23.1.5" ;;
    --components) out="$out core executionengine mcjit native" ;;
    --shared-mode) out="$out static" ;;
    --has-rtti) out="$out NO" ;;
    --cppflags) out="$out -I$here/include -DNDEBUG -DLLVM_FROM_CPPFLAGS" ;;
    --cflags) out="$out -DLLVM_FROM_CFLAGS" ;;
    --ldflags) out="$out -L$here/lib" ;;
    --link-static) link=static ;;
    --link-shared) link=shared ;;
    --system-libs) system=1 ;;
    --libs) libs=1 ;;
    --libfiles) out="$out $here/lib/libLLVM.a" ;;
    --*) exit 1 ;;
    *) out="$out $(link_symbol "llvm_module_$arg")" ;;
  esac
done
if [ -n "$libs" ]; then
  out="$out $(link_symbol "llvm_link_$link")"
fi
if [ -n "$system" ]; then
  out="$out $(link_symbol llvm_system_libs)"
fi
echo $out
